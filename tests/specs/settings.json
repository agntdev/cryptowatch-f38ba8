[
  {
    "name": "/settings shows empty watchlist and defaults",
    "steps": [
      {
        "send": { "text": "/settings" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "⚙️ Your settings:\n\nWatchlist: empty — tap ➕ Add coin to add one.\n\nQuiet hours: 22:00–08:00\nDaily summary: 09:00"
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Settings menu button shows settings",
    "steps": [
      {
        "send": { "callback": "settings:show" },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "⚙️ Your settings:\n\nWatchlist: empty — tap ➕ Add coin to add one.\n\nQuiet hours: 22:00–08:00\nDaily summary: 09:00"
            }
          }
        ]
      }
    ]
  }
]
