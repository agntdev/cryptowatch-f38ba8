[
  {
    "name": "/add without arguments shows usage",
    "steps": [
      {
        "send": { "text": "/add" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "To add a coin, type:\n/add BTC\n/add ETH\n/add SOL"
            }
          }
        ]
      }
    ]
  },
  {
    "name": "/add with unknown ticker shows suggestions",
    "steps": [
      {
        "send": { "text": "/add XYZXYZ" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Couldn't find a coin with ticker \"XYZXYZ\".\nCheck the ticker symbol and try again."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "Add coin menu button shows usage",
    "steps": [
      {
        "send": { "callback": "add:show" },
        "expect": [
          {
            "method": "editMessageText",
            "payload": {
              "text": "To add a coin, type:\n/add BTC\n/add ETH\n/add SOL"
            }
          }
        ]
      }
    ]
  }
]
